# Phoenix Insurance Telegram Bot Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED: Telegram Bot Token
# ===========================================
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===========================================
# REQUIRED: Google Gemini API Key
# ===========================================
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# OPTIONAL: Gemini Model
# ===========================================
# Options: gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# ===========================================
# OPTIONAL: Data Directory
# ===========================================
# Where to store downloaded PDFs and database
DATA_DIR=data

# ===========================================
# OPTIONAL: Browser Settings
# ===========================================
# Set to false to see the browser (useful for debugging)
HEADLESS=true

# ===========================================
# OPTIONAL: Timeouts (in seconds)
# ===========================================
OTP_TIMEOUT=300
SCRAPER_TIMEOUT=600
